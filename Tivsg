                }
            ]
        };

        // Persistent State Management
        let currentPlaylist = [];
        let currentTrackIndex = 0;
        let isPlaying = false;
        let isMuted = false;
        let repeatSingle = false;

        // Sound System Interfaces
        let audioInstance = null;
        let audioContext = null;
        let audioSource = null;
        let audioAnalyser = null;
        let visualizerAnimationId = null;

        // Sub-Bass Live Synth Engine Nodes
        let synthAudioContext = null;
        let synthOscillator = null;
        let synthGain = null;
        let synthFilter = null;

        // Dom Load Sequence
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            loadState();
            initSovereignEngine();
            initMatrixBackground();
        });

        // Initialize state from LocalStorage or Defaults
        function loadState() {
            const savedTracks = localStorage.getItem('SOVEREIGN_PLAYLIST');
            if(savedTracks) {
                try {
                    currentPlaylist = JSON.parse(savedTracks);
                } catch(e) {
                    currentPlaylist = [...DEFAULT_CONFIG.tracks];
                }
            } else {
                currentPlaylist = [...DEFAULT_CONFIG.tracks];
            }
        }

        // Initialize Primary Engine Layout
        function initSovereignEngine() {
            audioInstance = new Audio();
            audioInstance.crossOrigin = "anonymous";
            audioInstance.volume = 0.8;
            
            // Video Stage Link setup
            const videoElement = document.getElementById('album-video');
