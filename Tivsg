                cover: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=600&auto=format&fit=crop",
                streamUrl: url,
                duration: "LIVE SOURCE",
                lore: "An external coordinate injected on-the-fly directly into the browser session runtime."
