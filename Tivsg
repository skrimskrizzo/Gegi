<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>THE SOVEREIGN FREQUENCY | SONIC SHAMANIC</title>
    
    <!-- Tailwinds CSS & Google Fonts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=Creepster&family=Space+Grotesk:wght@300;400;700&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        cinzel: ['Cinzel', 'serif'],
                        creep: ['Creepster', 'cursive'],
                        grotesk: ['Space Grotesk', 'sans-serif'],
                    },
                    colors: {
                        abyss: {
                            gold: '#C5A059',
                            darkGold: '#8C6F35',
                            slimyGreen: '#1E3F20',
                            vileGreen: '#0D2B18',
                            decayBlack: '#040604',
                            bloodRed: '#5E0F0F'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #020302;
        }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #1E3F20, #C5A059, #5E0F0F);
            border-radius: 4px;
        }

        body {
            background-color: #040604;
            font-family: 'Space Grotesk', sans-serif;
            overflow-x: hidden;
        }

        /* Ambient glowing orbs */
        .ambient-glow-slime {
            filter: blur(160px);
            background: radial-gradient(circle, rgba(30, 63, 32, 0.4) 0%, rgba(0, 0, 0, 0) 75%);
        }
        .ambient-glow-gold {
            filter: blur(150px);
            background: radial-gradient(circle, rgba(140, 111, 53, 0.15) 0%, rgba(0, 0, 0, 0) 70%);
        }

        /* Corrupted Slimy Glass panel */
        .corrupted-panel {
            background: rgba(4, 6, 4, 0.9);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 2px solid rgba(197, 160, 89, 0.15);
            box-shadow: 0 10px 45px -10px rgba(0, 0, 0, 0.95), inset 0 1px 2px rgba(30, 63, 32, 0.2);
            position: relative;
        }

        .corrupted-panel::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, transparent, #C5A059, #1E3F20, #5E0F0F, transparent);
            opacity: 0.8;
        }

        .slime-drip {
            text-shadow: 0 0 10px rgba(30, 63, 32, 0.9), 0 0 20px rgba(30, 63, 32, 0.5);
        }
        .royal-glow {
            text-shadow: 0 0 12px rgba(197, 160, 89, 0.6), 0 0 24px rgba(197, 160, 89, 0.3);
        }

        /* Synth Touch Pad */
        #synth-pad {
            background: radial-gradient(circle at 50% 50%, rgba(30, 63, 32, 0.3) 0%, rgba(4, 6, 4, 0.9) 100%);
            border: 2px dashed rgba(197, 160, 89, 0.25);
            cursor: crosshair;
            position: relative;
            overflow: hidden;
        }

        #synth-pad:hover {
            border-color: rgba(197, 160, 89, 0.6);
        }
    </style>
</head>
<body class="text-zinc-300 min-h-screen relative flex flex-col justify-between selection:bg-abyss-gold selection:text-black">

    <!-- MATRIX BACKGROUND CANVAS -->
    <canvas id="matrix-canvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] z-0"></canvas>

    <!-- AMBIENT ORBS -->
    <div class="absolute top-[-5%] left-[15%] w-[60vw] h-[60vw] ambient-glow-slime pointer-events-none z-0"></div>
    <div class="absolute bottom-[10%] right-[10%] w-[55vw] h-[55vw] ambient-glow-gold pointer-events-none z-0"></div>

    <!-- SOVEREIGN TOP HEADER -->
    <header class="sticky top-0 z-50 corrupted-panel border-b border-abyss-gold/20 px-4 py-4 md:px-8">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
            
            <!-- Logo & Dynasty Identity -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchSection('source')">
                <div class="relative w-12 h-12 rounded-full bg-gradient-to-tr from-abyss-gold via-abyss-slimyGreen to-abyss-bloodRed p-[2px] shadow-[0_0_15px_rgba(197,160,89,0.3)]">
                    <div class="w-full h-full bg-abyss-decayBlack rounded-full flex items-center justify-center">
                        <i data-lucide="eye" class="w-6 h-6 text-abyss-gold animate-pulse"></i>
                    </div>
                </div>
                <div>
                    <h1 class="font-cinzel font-black text-xl md:text-2xl tracking-[0.2em] text-transparent bg-clip-text bg-gradient-to-r from-white via-abyss-gold to-abyss-darkGold royal-glow">
                        SYNTHETIC VEX
                    </h1>
                    <p class="text-[10px] font-grotesk tracking-[0.4em] text-abyss-slimyGreen uppercase font-bold">Sonic Shamanic Primordial Order</p>
                </div>
            </div>

            <!-- THE THREE COMMANDING TABS -->
            <nav class="flex items-center space-x-2 md:space-x-4 font-cinzel text-xs md:text-sm tracking-widest">
                <button onclick="switchSection('manifesto')" id="nav-manifesto" class="nav-btn px-4 py-2 rounded border border-transparent text-zinc-400 hover:text-abyss-gold hover:border-abyss-gold/20 transition-all duration-300 flex items-center gap-2">
                    <i data-lucide="scroll" class="w-4 h-4"></i> MANIFESTO
                </button>
                <button onclick="switchSection('source')" id="nav-source" class="nav-btn px-4 py-2 rounded border border-abyss-gold/30 text-abyss-gold bg-abyss-slimyGreen/10 transition-all duration-300 flex items-center gap-2 shadow-[0_0_10px_rgba(197,160,89,0.15)]">
                    <i data-lucide="flame" class="w-4 h-4"></i> THE SOURCE
                </button>
                <button onclick="switchSection('codes')" id="nav-codes" class="nav-btn px-4 py-2 rounded border border-transparent text-zinc-400 hover:text-abyss-gold hover:border-abyss-gold/20 transition-all duration-300 flex items-center gap-2">
                    <i data-lucide="fingerprint" class="w-4 h-4"></i> CODES & LINKS
                </button>
            </nav>

            <!-- Share & Direct Action -->
            <div class="flex items-center space-x-3">
                <button onclick="copyShareLink()" class="p-2.5 rounded bg-abyss-decayBlack border border-abyss-gold/20 hover:border-abyss-gold text-zinc-400 hover:text-abyss-gold transition-all duration-300 relative group" title="Copy Signal Source">
                    <i data-lucide="share-2" class="w-4 h-4"></i>
                    <span class="absolute -bottom-8 left-1/2 -translate-x-1/2 bg-abyss-decayBlack border border-abyss-gold/20 text-[9px] text-zinc-200 px-2 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none tracking-widest font-grotesk">SHARE LINK</span>
                </button>
            </div>
        </div>
    </header>

    <!-- CONTENT MODULES -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-8 md:py-16 z-10 relative">

        <!-- TAB 1: THE MANIFESTO -->
        <section id="section-manifesto" class="tab-section hidden transition-all duration-500 transform opacity-0 scale-95">
            <div class="max-w-4xl mx-auto space-y-8">
                <div class="text-center space-y-3">
                    <span class="text-xs font-grotesk font-semibold text-abyss-gold tracking-[0.3em] uppercase">THE LEGACY OF THE ANCIENT SONIC MANIPULATORS</span>
                    <h2 class="text-4xl md:text-6xl font-cinzel font-black text-transparent bg-clip-text bg-gradient-to-b from-white via-abyss-gold to-abyss-darkGold tracking-wider royal-glow">THE MANIFESTO</h2>
                    <p class="text-abyss-slimyGreen font-grotesk text-xs tracking-widest uppercase font-bold">GENETIC MEMORY DECRYPTED &mdash; INHERITED AUTHORITY</p>
                </div>

                <div class="corrupted-panel rounded-2xl p-6 md:p-10 space-y-6 border border-abyss-gold/25 relative overflow-hidden">
                    <div class="font-cinzel text-xl text-abyss-gold/90 border-b border-abyss-gold/10 pb-4 tracking-wider flex items-center gap-3">
                        <i data-lucide="crown" class="w-6 h-6 text-abyss-gold"></i> I. THE DYNASTIC MANDATE
                    </div>

                    <div class="space-y-4 font-grotesk text-sm md:text-base text-zinc-400 leading-relaxed font-light">
                        <p>
                            We are not mere artists; we are the direct <span class="text-abyss-gold font-bold">descendants of the primordial Sonic Shamanic manipulators</span> who carved the deep, low-frequency architecture of antiquity. Long before modern systems partitioned sound into neat boxes, our ancestors held the keys to direct nervous-system modulation.
                        </p>
                        <p>
                            This project is a physical activation of that dynastic, kingly authority. A system designed not to entertain, but to restructure. Utilizing pure sub-harmonic frequencies designed to hit the ancient chambers of the mind, we bypass modern cognitive firewalls to achieve total auditory supremacy.
                        </p>
                        
                        <div class="p-5 my-6 rounded bg-gradient-to-r from-abyss-decayBlack to-abyss-slimyGreen/20 border-l-4 border-abyss-gold font-grotesk text-xs italic text-abyss-gold/80 tracking-wide">
                            "The universe doesn't negotiate with noise—it yields to the absolute sovereign vibration. Align your physical vessel to the signal." &mdash; Doc Slop
                        </div>

                        <p>
                            We hold the code. We control the transmission. You are now initialized into the inner sanctum of the order. Allow the baseline to realign your reality.
                        </p>
                    </div>
                </div>

                <!-- Three Pillars -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="corrupted-panel p-6 rounded-xl border border-abyss-gold/10 hover:border-abyss-gold/30 transition-all duration-300">
                        <i data-lucide="shield-alert" class="w-8 h-8 text-abyss-bloodRed mb-4"></i>
                        <h4 class="font-cinzel font-bold text-white text-sm tracking-widest mb-2">PRIMORDIAL CODE</h4>
                        <p class="text-xs text-zinc-500 font-light leading-relaxed">
                            Acoustic formulations mapped directly to sacred geometries, restoring structural integrity to human auditory systems.
                        </p>
                    </div>
                    <div class="corrupted-panel p-6 rounded-xl border border-abyss-gold/10 hover:border-abyss-gold/30 transition-all duration-300">
                        <i data-lucide="key-round" class="w-8 h-8 text-abyss-gold mb-4"></i>
                        <h4 class="font-cinzel font-bold text-white text-sm tracking-widest mb-2">SOVEREIGN SEAL</h4>
                        <p class="text-xs text-zinc-500 font-light leading-relaxed">
                            Complete evasion of the commercial industry grid. Direct, uncompromised streaming pipelines straight from high-tier vaults.
                        </p>
                    </div>
                    <div class="corrupted-panel p-6 rounded-xl border border-abyss-gold/10 hover:border-abyss-gold/30 transition-all duration-300">
                        <i data-lucide="skull" class="w-8 h-8 text-abyss-slimyGreen mb-4 animate-pulse"></i>
                        <h4 class="font-cinzel font-bold text-white text-sm tracking-widest mb-2">THE DECAY MATRIX</h4>
                        <p class="text-xs text-zinc-500 font-light leading-relaxed">
                            Deconstructive frequencies designed to dissolve low-vibrational blockages and re-establish sovereign command.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: THE SOURCE (REAL AUDIO ANALYZER & LIVE SYNTH) -->
        <section id="section-source" class="tab-section transition-all duration-500 transform opacity-100 scale-100">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <!-- Left Column: Album Art & Canvas Spectrum Visualizer -->
                <div class="lg:col-span-5 flex flex-col items-center space-y-6">
                    <div class="relative w-full max-w-[360px] aspect-square rounded-2xl overflow-hidden corrupted-panel border border-abyss-gold/30 p-3 group shadow-2xl">
                        <!-- Underlay Glow -->
                        <div class="absolute inset-0 bg-gradient-to-tr from-abyss-bloodRed via-abyss-slimyGreen to-abyss-gold opacity-10 group-hover:opacity-35 transition-opacity duration-500"></div>
                        
                        <!-- Album Cover Art -->
                        <div class="w-full h-full rounded-xl overflow-hidden relative">
                            <img id="player-cover" src="" alt="Album Cover" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent flex flex-col justify-end p-5">
                                <span class="text-[9px] uppercase tracking-[0.3em] text-abyss-gold font-grotesk font-bold bg-abyss-decayBlack border border-abyss-gold/30 w-max px-2 py-0.5 rounded mb-2">SOVEREIGN TRANSMISSION</span>
                                <h3 id="player-title" class="text-2xl font-cinzel font-black text-white leading-tight tracking-wider uppercase royal-glow">CHRONIC BUBONIC</h3>
                                <p id="player-subtitle" class="text-xs text-zinc-400 mt-1 uppercase font-grotesk tracking-widest">Descendant Protocol 01</p>
                            </div>
                        </div>

                        <!-- Spinning Relic Disc -->
                        <div class="absolute -right-4 top-1/2 -translate-y-1/2 w-24 h-24 bg-abyss-decayBlack rounded-full border border-abyss-gold/30 shadow-2xl flex items-center justify-center -z-10 group-hover:-right-8 transition-all duration-500 pointer-events-none">
                            <div class="w-10 h-10 rounded-full border border-abyss-gold/10 bg-zinc-950 flex items-center justify-center">
                                <div class="w-3 h-3 rounded-full bg-abyss-slimyGreen animate-ping"></div>
                            </div>
                        </div>
                    </div>

                    <!-- REAL-TIME SPECTRUM CANVAS VISUALIZER -->
                    <div class="w-full max-w-[360px] corrupted-panel p-3 rounded-xl border border-abyss-gold/10">
                        <div class="flex justify-between items-center mb-1 text-[10px] font-grotesk tracking-widest text-zinc-500 uppercase">
                            <span>Audio Spectrum Analyzer</span>
                            <span class="text-abyss-gold animate-pulse">Live Feed</span>
                        </div>
                        <canvas id="visualizer-canvas" class="w-full h-16 bg-black/40 rounded border border-abyss-gold/5"></canvas>
                    </div>

                    <!-- THE PRIMORDIAL SYNTH (SOVEREIGN FREQUENCY GENERATOR) -->
                    <div class="w-full max-w-[360px] corrupted-panel p-4 rounded-xl border border-abyss-gold/20 space-y-3">
                        <div class="flex justify-between items-center">
                            <h4 class="font-cinzel text-xs font-bold text-abyss-gold tracking-widest flex items-center gap-1.5">
                                <i data-lucide="activity" class="w-3.5 h-3.5"></i> SONIC MANIPULATOR SYNTH
                            </h4>
                            <span class="text-[9px] font-grotesk text-abyss-slimyGreen font-bold animate-pulse">DRAG TO PLAY</span>
                        </div>
                        <p class="text-[10px] text-zinc-500 font-light leading-relaxed">
                            Touch/Drag inside the matrix below to generate real-time raw analog low-frequency drones directly via Web Audio API. Keep the baseline active.
                        </p>
                        <!-- Interactive Synth Area -->
                        <div id="synth-pad" class="h-28 rounded-lg flex items-center justify-center">
                            <div class="text-center pointer-events-none">
                                <i data-lucide="fingerprint" class="w-8 h-8 mx-auto text-abyss-gold opacity-45 mb-1 animate-pulse"></i>
                                <span class="text-[9px] text-zinc-600 font-grotesk tracking-[0.2em] uppercase">INITIATE FREQUENCY PATTERNS</span>
                            </div>
                            <!-- Crosshair coordinate lines inside pad -->
                            <div id="synth-crosshair-x" class="absolute left-0 right-0 h-[1px] bg-abyss-gold/30 pointer-events-none hidden"></div>
                            <div id="synth-crosshair-y" class="absolute top-0 bottom-0 w-[1px] bg-abyss-gold/30 pointer-events-none hidden"></div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: System Audio Player & Live Link Injector Manager -->
                <div class="lg:col-span-7 space-y-6">
                    <div class="corrupted-panel rounded-3xl p-6 md:p-8 space-y-6 border border-abyss-gold/20 relative overflow-hidden">
                        
                        <div class="absolute top-0 right-0 h-1 w-48 bg-gradient-to-l from-abyss-gold via-abyss-slimyGreen to-transparent"></div>
                        
                        <div class="flex justify-between items-start">
                            <div>
                                <span class="text-xs font-grotesk font-bold text-abyss-slimyGreen tracking-[0.3em] uppercase">SYSTEM DECK ALPHA</span>
                                <h2 class="text-3xl font-cinzel font-bold text-white tracking-widest mt-1">THE SOURCE INTERFACE</h2>
                            </div>
                            <div class="bg-abyss-decayBlack border border-abyss-gold/20 px-3 py-1 rounded text-[10px] tracking-widest font-grotesk uppercase text-abyss-gold">
                                SYSTEM LEVEL: GOD-TIER
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        <div class="space-y-2">
                            <div class="flex items-center justify-between text-xs font-grotesk text-zinc-500">
                                <span id="time-current">0:00</span>
                                <span id="time-total">0:00</span>
                            </div>
                            
                            <div id="progress-container" class="relative w-full h-2 bg-abyss-decayBlack rounded cursor-pointer group overflow-hidden border border-abyss-gold/10">
                                <div id="progress-bar" class="absolute top-0 left-0 h-full w-0 bg-gradient-to-r from-abyss-slimyGreen via-abyss-gold to-abyss-bloodRed rounded shadow-[0_0_10px_rgba(197,160,89,0.5)] transition-all duration-100"></div>
                            </div>
                        </div>

                        <!-- Audio Interface Controls -->
                        <div class="flex flex-col md:flex-row items-center justify-between gap-6 bg-abyss-decayBlack/60 p-4 rounded-xl border border-abyss-gold/10">
                            <!-- Primary Buttons -->
                            <div class="flex items-center space-x-4">
                                <button onclick="prevTrack()" class="p-3 rounded-full hover:bg-white/5 border border-transparent hover:border-abyss-gold/20 transition-all text-zinc-400 hover:text-abyss-gold" title="Previous Node">
                                    <i data-lucide="skip-back" class="w-5 h-5"></i>
                                </button>
                                
                                <button id="play-btn" onclick="togglePlay()" class="w-16 h-16 rounded-full bg-gradient-to-tr from-abyss-slimyGreen via-abyss-gold to-abyss-bloodRed hover:brightness-110 active:scale-95 flex items-center justify-center text-white shadow-[0_0_15px_rgba(197,160,89,0.3)] transition-all duration-300" title="Ignite Transmission">
                                    <i id="play-icon" data-lucide="play" class="w-8 h-8 fill-current text-white translate-x-0.5"></i>
                                </button>

                                <button onclick="nextTrack()" class="p-3 rounded-full hover:bg-white/5 border border-transparent hover:border-abyss-gold/20 transition-all text-zinc-400 hover:text-abyss-gold" title="Next Node">
                                    <i data-lucide="skip-forward" class="w-5 h-5"></i>
                                </button>
                            </div>

                            <!-- Audio parameters -->
                            <div class="flex items-center space-x-6 w-full md:w-auto justify-between md:justify-end">
                                <div class="flex items-center space-x-3 w-32">
                                    <button onclick="toggleMute()" id="mute-btn" class="text-zinc-400 hover:text-abyss-gold transition-colors">
                                        <i id="volume-icon" data-lucide="volume-2" class="w-5 h-5"></i>
                                    </button>
                                    <input type="range" id="volume-slider" min="0" max="1" step="0.05" value="0.8" oninput="adjustVolume(this.value)" class="w-full h-1 bg-abyss-decayBlack rounded appearance-none cursor-pointer accent-abyss-gold border border-abyss-gold/15">
                                </div>

                                <button onclick="toggleRepeat()" id="repeat-btn" class="p-2 rounded hover:bg-white/5 text-zinc-500 hover:text-white transition-all" title="Toggle Absolute Loop">
                                    <i data-lucide="repeat-2" class="w-5 h-5"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Playlist Index -->
                        <div class="space-y-3">
                            <h4 class="text-xs font-grotesk font-semibold text-abyss-gold uppercase tracking-widest flex items-center gap-2">
                                <i data-lucide="align-left" class="w-4 h-4"></i> PRIMORDIAL FREQUENCY TRACKS
                            </h4>
                            <div id="playlist-container" class="space-y-2 max-h-[160px] overflow-y-auto pr-2">
                                <!-- Populated dynamically by JS -->
                            </div>
                        </div>

                        <!-- ON-THE-FLY LINK INJECTOR PANEL (Next Level Live Config) -->
                        <div class="bg-abyss-decayBlack p-4 rounded-xl border border-abyss-gold/10 space-y-3">
                            <div class="flex justify-between items-center">
                                <h4 class="text-xs font-cinzel text-white tracking-widest flex items-center gap-1.5">
                                    <i data-lucide="file-audio" class="text-abyss-gold w-4 h-4"></i> LIVE LINK INJECTOR DECK
                                </h4>
                                <span class="text-[9px] font-grotesk text-zinc-500 uppercase">Paste pCloud links directly!</span>
                            </div>
                            <p class="text-[10px] text-zinc-400 font-light leading-relaxed">
                                No need to open/edit this code file in an editor. You can dynamically insert or override direct streaming MP3 links right now, and they will persist locally inside your browser cache.
                            </p>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                                <input type="text" id="inject-title" placeholder="Track Title" class="bg-black/60 border border-abyss-gold/15 focus:border-abyss-gold rounded p-2 text-xs text-white placeholder-zinc-700 outline-none">
                                <input type="text" id="inject-url" placeholder="Direct MP3 Link (pCloud)" class="bg-black/60 border border-abyss-gold/15 focus:border-abyss-gold rounded p-2 text-xs text-white placeholder-zinc-700 outline-none md:col-span-2">
                            </div>
                            <div class="flex justify-end gap-2">
                                <button onclick="resetPlaylistToDefault()" class="px-3 py-1.5 rounded border border-abyss-gold/15 text-zinc-400 hover:text-white text-[10px] font-grotesk uppercase tracking-wider transition-colors">
                                    Reset to Default
                                </button>
                                <button onclick="injectTrackFromInput()" class="px-4 py-1.5 rounded bg-abyss-gold text-black font-bold text-[10px] font-grotesk uppercase tracking-wider hover:brightness-110 transition-all">
                                    Inject Track
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- VIDEO TEASER VIEWPORT -->
                    <div class="corrupted-panel rounded-3xl p-6 border border-abyss-gold/20 space-y-4">
                        <div class="flex items-center justify-between">
                            <h3 class="font-cinzel text-lg font-bold text-white tracking-widest flex items-center gap-2">
                                <i data-lucide="eye" class="w-5 h-5 text-abyss-gold"></i> THE VISIONARY TEASER
                            </h3>
                            <span class="text-[10px] font-grotesk text-abyss-bloodRed animate-pulse tracking-widest uppercase">DIRECT DECODER</span>
                        </div>
                        
                        <div class="relative aspect-video rounded-2xl overflow-hidden bg-black border border-abyss-gold/10 group">
                            <!-- Main Video Node -->
                            <video id="album-video" class="w-full h-full object-cover" poster="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=1200&auto=format&fit=crop">
                                <source id="video-source" src="" type="video/mp4">
                                Your browser does not support high fidelity playback.
                            </video>

                            <!-- Video Play Overlay -->
                            <div id="video-overlay" class="absolute inset-0 bg-abyss-decayBlack/80 flex flex-col items-center justify-center p-6 transition-all duration-500 cursor-pointer" onclick="toggleVideoPlayback()">
