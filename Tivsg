            const videoDirectBtn = document.getElementById('video-direct-btn');
            
            if(DEFAULT_CONFIG.videoTeaserUrl) {
                videoSource.src = DEFAULT_CONFIG.videoTeaserUrl;
                videoDirectBtn.href = DEFAULT_CONFIG.videoTeaserUrl;
                videoElement.load();
            }

            // Sync Core Lists
            renderSovereignPlaylist();
            loadTrack(0, false);

            // Audio Nodes Hooks
            audioInstance.addEventListener('timeupdate', updateProgressUI);
            audioInstance.addEventListener('ended', handleTrackEnded);
            audioInstance.addEventListener('loadedmetadata', () => {
                document.getElementById('time-total').innerText = formatTime(audioInstance.duration);
            });

            // Seeker Action
            const progressContainer = document.getElementById('progress-container');
            progressContainer.addEventListener('click', (e) => {
                const rect = progressContainer.getBoundingClientRect();
                const clickPos = (e.clientX - rect.left) / rect.width;
                if(audioInstance.duration) {
                    audioInstance.currentTime = clickPos * audioInstance.duration;
                }
            });

            // Interactive Live Synth Pad Event Binding
            const synthPad = document.getElementById('synth-pad');
            synthPad.addEventListener('mousedown', startLiveSynth);
            synthPad.addEventListener('mousemove', playLiveSynth);
            synthPad.addEventListener('mouseup', stopLiveSynth);
            synthPad.addEventListener('mouseleave', stopLiveSynth);

            // Mobile touch interfaces
            synthPad.addEventListener('touchstart', (e) => { e.preventDefault(); startLiveSynth(e.touches[0]); });
            synthPad.addEventListener('touchmove', (e) => { e.preventDefault(); playLiveSynth(e.touches[0]); });
            synthPad.addEventListener('touchend', stopLiveSynth);
        }

        // Web Audio Dynamic Analyzer initialization on User Interaction
        function setupAudioAnalysis() {
            if (audioContext) return; // Already setup

            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                audioContext = new AudioCtx();
                audioSource = audioContext.createMediaElementSource(audioInstance);
                audioAnalyser = audioContext.createAnalyser();
                audioAnalyser.fftSize = 64;

                audioSource.connect(audioAnalyser);
                audioAnalyser.connect(audioContext.destination);

                startCanvasAnalysis();
            } catch(e) {
                console.warn("Raw Audio context link failed to route: ", e);
            }
        }

        // Canvas render engine for live spectrum analysis
        function startCanvasAnalysis() {
            const canvas = document.getElementById('visualizer-canvas');
            const ctx = canvas.getContext('2d');
            const bufferLength = audioAnalyser.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);

            function draw() {
                visualizerAnimationId = requestAnimationFrame(draw);
                audioAnalyser.getByteFrequencyData(dataArray);

                ctx.fillStyle = 'rgba(4, 6, 4, 0.4)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                const barWidth = (canvas.width / bufferLength) * 1.5;
                let barHeight;
                let x = 0;

                for (let i = 0; i < bufferLength; i++) {
                    barHeight = dataArray[i] / 2;

                    // Slime gradient coloring
                    const gradient = ctx.createLinearGradient(0, canvas.height, 0, 0);
                    gradient.addColorStop(0, '#1E3F20');
                    gradient.addColorStop(0.7, '#C5A059');
                    gradient.addColorStop(1, '#5E0F0F');

                    ctx.fillStyle = gradient;
                    ctx.fillRect(x, canvas.height - barHeight, barWidth - 2, barHeight);

                    x += barWidth;
                }
            }
            draw();
        }

        // Sub-Bass Live Synth Engine using standard Web Audio Nodes
        function startLiveSynth(e) {
            // Initiate unique context for Synth
            if (!synthAudioContext) {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                synthAudioContext = new AudioCtx();
            }

            if (synthAudioContext.state === 'suspended') {
                synthAudioContext.resume();
            }

            // Custom sound shape configurations
            synthOscillator = synthAudioContext.createOscillator();
            synthGain = synthAudioContext.createGain();
            synthFilter = synthAudioContext.createBiquadFilter();

            // Set to classic fat, dark sawtooth or triangle frequency
            synthOscillator.type = 'sawtooth';
            
            // Low-pass filter to block highs and produce that pure evil deep drone
            synthFilter.type = 'lowpass';
            synthFilter.frequency.setValueAtTime(140, synthAudioContext.currentTime);
            synthFilter.Q.setValueAtTime(8, synthAudioContext.currentTime);

            synthOscillator.connect(synthFilter);
            synthFilter.connect(synthGain);
            synthGain.connect(synthAudioContext.destination);

            synthGain.gain.setValueAtTime(0, synthAudioContext.currentTime);
            // Smooth ramp up
            synthGain.gain.linearRampToValueAtTime(0.25, synthAudioContext.currentTime + 0.05);

            synthOscillator.start();
            showCrosshairs(true);
            playLiveSynth(e);
        }

        function playLiveSynth(e) {
            if (!synthOscillator) return;

            const pad = document.getElementById('synth-pad');
            const rect = pad.getBoundingClientRect();
            
            // X coordinate calculates Frequency (Range: 45Hz to 180Hz)
            const x = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
            const freq = 45 + (x * 135); 
            synthOscillator.frequency.setTargetAtTime(freq, synthAudioContext.currentTime, 0.05);

            // Y coordinate calculates Filter Cutoff (Range: 80Hz to 600Hz)
            const y = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));
            const cutoff = 80 + ((1 - y) * 520);
            synthFilter.frequency.setTargetAtTime(cutoff, synthAudioContext.currentTime, 0.05);

            // UI feedback
            updateCrosshairs(x * rect.width, y * rect.height);
        }

        function stopLiveSynth() {
            if (synthOscillator) {
                try {
                    synthGain.gain.cancelScheduledValues(synthAudioContext.currentTime);
                    synthGain.gain.setValueAtTime(synthGain.gain.value, synthAudioContext.currentTime);
                    // Smooth release
                    synthGain.gain.exponentialRampToValueAtTime(0.001, synthAudioContext.currentTime + 0.15);
                    const osc = synthOscillator;
                    setTimeout(() => osc.stop(), 200);
                } catch(e) {}
                
                synthOscillator = null;
                synthGain = null;
                synthFilter = null;
            }
            showCrosshairs(false);
        }

        function showCrosshairs(show) {
            const display = show ? 'block' : 'none';
            document.getElementById('synth-crosshair-x').style.display = display;
            document.getElementById('synth-crosshair-y').style.display = display;
        }

        function updateCrosshairs(x, y) {
            document.getElementById('synth-crosshair-x').style.top = `${y}px`;
            document.getElementById('synth-crosshair-y').style.left = `${x}px`;
        }

        // On-the-Fly Dynamic Link Injector Engine
        function injectTrackFromInput() {
            const titleInput = document.getElementById('inject-title');
            const urlInput = document.getElementById('inject-url');

            const title = titleInput.value.trim();
