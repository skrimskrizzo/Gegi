            localStorage.setItem('SOVEREIGN_PLAYLIST', JSON.stringify(currentPlaylist));

            titleInput.value = '';
            urlInput.value = '';

            renderSovereignPlaylist();
            showSystemNotify("SIGNAL INJECTED", `${newTrack.title} added to the sovereign rotation.`);
        }

        function resetPlaylistToDefault() {
            currentPlaylist = [...DEFAULT_CONFIG.tracks];
            localStorage.removeItem('SOVEREIGN_PLAYLIST');
            renderSovereignPlaylist();
            loadTrack(0, false);
            showSystemNotify("VAULTS COOLDOWN", "Sovereign playlist restored to system default benchmarks.");
        }

        // Dynamic UI Generation
        function renderSovereignPlaylist() {
            const container = document.getElementById('playlist-container');
            container.innerHTML = '';

            currentPlaylist.forEach((track, idx) => {
                const isActive = idx === currentTrackIndex;
                const node = document.createElement('div');
                node.className = `p-3.5 rounded border flex items-center justify-between cursor-pointer transition-all duration-300 ${
                    isActive 
                    ? 'bg-abyss-vileGreen border-abyss-gold/50 shadow-[0_0_15px_rgba(197,160,89,0.15)]' 
                    : 'bg-abyss-decayBlack/50 border-abyss-gold/10 hover:border-abyss-gold/30'
                }`;
                node.onclick = () => selectTrack(idx);
                node.innerHTML = `
                    <div class="flex items-center space-x-3 overflow-hidden">
                        <div class="relative w-10 h-10 rounded overflow-hidden bg-black/60">
                            <img src="${track.cover}" class="w-full h-full object-cover">
                            ${isActive ? '<div class="absolute inset-0 bg-abyss-slimyGreen/25 flex items-center justify-center"><div class="w-2 h-2 rounded-full bg-abyss-gold animate-ping"></div></div>' : ''}
                        </div>
                        <div class="overflow-hidden">
                            <h5 class="text-xs font-bold font-cinzel ${isActive ? 'text-abyss-gold' : 'text-zinc-300'} truncate tracking-wide">${track.title}</h5>
                            <p class="text-[9px] text-zinc-500 truncate mt-0.5 tracking-widest font-grotesk uppercase">${track.subtitle}</p>
