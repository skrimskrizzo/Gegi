                    cover: "https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?q=80&w=600&auto=format&fit=crop",
                    streamUrl: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3",
