            }
            loadTrack(nextIndex, true);
            showSystemNotify("NODE ROTATED", `Ascending to: ${currentPlaylist[nextIndex].title}`);
        }

        function prevTrack() {
            let prevIndex = currentTrackIndex - 1;
            if(prevIndex < 0) {
                prevIndex = currentPlaylist.length - 1;
            }
            loadTrack(prevIndex, true);
            showSystemNotify("NODE ROTATED", `Descending to: ${currentPlaylist[prevIndex].title}`);
        }

        function toggleMute() {
            isMuted = !isMuted;
            audioInstance.muted = isMuted;
            const icon = document.getElementById('volume-icon');
            if(isMuted) {
                icon.setAttribute('data-lucide', 'volume-x');
                document.getElementById('volume-slider').value = 0;
            } else {
                icon.setAttribute('data-lucide', 'volume-2');
                document.getElementById('volume-slider').value = audioInstance.volume;
            }
            lucide.createIcons();
        }

        function adjustVolume(val) {
            audioInstance.volume = val;
            isMuted = (val == 0);
            audioInstance.muted = isMuted;
            
            const icon = document.getElementById('volume-icon');
            if(val == 0) {
                icon.setAttribute('data-lucide', 'volume-x');
            } else if(val < 0.5) {
                icon.setAttribute('data-lucide', 'volume-1');
            } else {
                icon.setAttribute('data-lucide', 'volume-2');
            }
            lucide.createIcons();
        }

        function toggleRepeat() {
            repeatSingle = !repeatSingle;
            const btn = document.getElementById('repeat-btn');
            if(repeatSingle) {
                btn.classList.add('text-abyss-gold', 'bg-abyss-gold/10');
                showSystemNotify("LOOP ENFORCED", "Target frequency isolated into absolute loop recursion.");
            } else {
                btn.classList.remove('text-abyss-gold', 'bg-abyss-gold/10');
            }
        }

        function handleTrackEnded() {
            if(repeatSingle) {
                audioInstance.currentTime = 0;
                playAudio();
            } else {
                nextTrack();
            }
        }

        function updateProgressUI() {
            if(!audioInstance.duration) return;
            const percentage = (audioInstance.currentTime / audioInstance.duration) * 100;
            document.getElementById('progress-bar').style.width = `${percentage}%`;
            document.getElementById('time-current').innerText = formatTime(audioInstance.currentTime);
        }

        function updateUIState(playing) {
            const mainPlayIcon = document.getElementById('play-icon');
            const miniPlayIcon = document.getElementById('mini-play-icon');

            if(playing) {
                mainPlayIcon.setAttribute('data-lucide', 'pause');
                miniPlayIcon.setAttribute('data-lucide', 'pause');
            } else {
                mainPlayIcon.setAttribute('data-lucide', 'play');
                miniPlayIcon.setAttribute('data-lucide', 'play');
            }
            lucide.createIcons();
            renderSovereignPlaylist();
        }

        // Section View Switcher
        function switchSection(targetId) {
            const sections = document.querySelectorAll('.tab-section');
            const buttons = document.querySelectorAll('.nav-btn');

            sections.forEach(sec => {
                if(sec.id === `section-${targetId}`) {
                    sec.classList.remove('hidden');
                    setTimeout(() => {
                        sec.classList.remove('opacity-0', 'scale-95');
                        sec.classList.add('opacity-100', 'scale-100');
                    }, 50);
                } else {
                    sec.classList.add('hidden', 'opacity-0', 'scale-95');
                    sec.classList.remove('opacity-100', 'scale-100');
                }
            });

            buttons.forEach(btn => {
                if(btn.id === `nav-${targetId}`) {
                    btn.classList.add('text-abyss-gold', 'border-abyss-gold/30', 'bg-abyss-slimyGreen/10');
                    btn.classList.remove('text-zinc-400', 'border-transparent');
                } else {
                    btn.classList.remove('text-abyss-gold', 'border-abyss-gold/30', 'bg-abyss-slimyGreen/10');
                    btn.classList.add('text-zinc-400', 'border-transparent');
                }
            });

            const miniPlayer = document.getElementById('mini-player');
            if(targetId !== 'source' && isPlaying) {
                miniPlayer.classList.remove('translate-y-32', 'opacity-0');
                miniPlayer.classList.add('translate-y-0', 'opacity-100');
            } else {
                miniPlayer.classList.remove('translate-y-0', 'opacity-100');
                miniPlayer.classList.add('translate-y-32', 'opacity-0');
            }
        }

        function toggleVideoPlayback() {
            const video = document.getElementById('album-video');
            const overlay = document.getElementById('video-overlay');

            if(video.paused) {
                if(isPlaying) pauseAudio();

                video.play()
                    .then(() => {
                        overlay.classList.add('opacity-0', 'pointer-events-none');
                        showSystemNotify("VISION COMMENCED", "Direct visual projection pipeline fully active.");
                    });
            } else {
                video.pause();
                overlay.classList.remove('opacity-0', 'pointer-events-none');
            }
        }

        function copyShareLink() {
            const url = window.location.href;
            const tempInput = document.createElement('input');
            document.body.appendChild(tempInput);
            tempInput.value = url;
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            showSystemNotify("COORDINATES EXTRACTED", "Sovereign connection link cloned to clipboard.");
        }

        function showSystemNotify(title, msg) {
            const modal = document.getElementById('notification-modal');
            document.getElementById('notify-title').innerText = title;
            document.getElementById('notify-msg').innerText = msg;

            modal.classList.remove('translate-x-96', 'opacity-0');
            modal.classList.add('translate-x-0', 'opacity-100');

            setTimeout(() => {
                modal.classList.add('translate-x-96', 'opacity-0');
                modal.classList.remove('translate-x-0', 'opacity-100');
            }, 3500);
        }

        function handleSubscribe(e) {
            e.preventDefault();
            document.getElementById('subscribe-form').classList.add('hidden');
            document.getElementById('form-feedback').classList.remove('hidden');
            showSystemNotify("REGISTRY LOCKED", "Your node matrix ID is integrated into the grid.");
        }

        function formatTime(seconds) {
            if(isNaN(seconds)) return "0:00";
            const min = Math.floor(seconds / 60);
            const sec = Math.floor(seconds % 60);
            return `${min}:${sec < 10 ? '0' : ''}${sec}`;
        }

        // Matrix Dripping Slime Background Canvas Engine
        function initMatrixBackground() {
            const canvas = document.getElementById('matrix-canvas');
            const ctx = canvas.getContext('2d');

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            // Runic glyph arrays of ancient frequency manipulators
            const alphabet = "𐎦𐎧𐎨𐎩𐎪𐎫𐎬𐎭𐎮𐎯𐎰𐎱𐎲𐎳𐎴𐎵𐎶𐎷𐎸𐎹𐎺𐎻𐎼𐎽𐎾𐎿01𝚵𝛀𝚽";
            const fontSize = 14;
            const columns = canvas.width / fontSize;

            const rainDrops = [];
            for (let x = 0; x < columns; x++) {
                rainDrops[x] = 1;
            }

            function drawMatrix() {
                ctx.fillStyle = 'rgba(4, 6, 4, 0.05)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                for (let i = 0; i < rainDrops.length; i++) {
                    const text = alphabet.charAt(Math.floor(Math.random() * alphabet.length));
                    
                    // Alternating gold and slimy green drips
                    ctx.fillStyle = (i % 5 === 0) ? '#C5A059' : '#1E3F20';
                    ctx.font = fontSize + 'px monospace';
                    
                    ctx.fillText(text, i * fontSize, rainDrops[i] * fontSize);

                    if (rainDrops[i] * fontSize > canvas.height && Math.random() > 0.975) {
                        rainDrops[i] = 0;
                    }
                    rainDrops[i]++;
                }
            }
            setInterval(drawMatrix, 35);
        }
    </script>
</body>
</html>
